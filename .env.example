# Copy to .env (gitignored) or just export these before starting the floor.
# Every one of them is optional — the gateway can also be set in the UI's
# gateway tab, and it is remembered in data/floor.json.

# Where the OmniRoute gateway lives. Any OpenAI-compatible /v1 works.
OMNIROUTE_URL=http://localhost:20128/v1

# Only if your gateway requires one (OmniRoute dashboard → Endpoints).
# This is the gateway's own key — provider keys live inside OmniRoute, never here.
OMNIROUTE_KEY=

# The floor server's port.
PORT=20200
